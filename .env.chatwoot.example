# Chatwoot Configuration
# Copy this file to .env.chatwoot and update with your values

# Database
DB_NAME=chatwoot
DB_USER=chatwoot
DB_PASSWORD=chatwoot_password_change_me

# Rails
RAILS_ENV=production
SECRET_KEY_BASE=change-me-to-a-secure-random-string-32-chars-min

# Server URLs
FRONTEND_URL=http://localhost:3000
PORT=3000

# Email Configuration (optional)
# If you want to send emails, configure SMTP
MAILER_SENDER_EMAIL=noreply@weedmap.store
MAILER_SENDER_NAME=Weedmaps Support

# For Gmail:
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_AUTHENTICATION=login
# SMTP_ENABLE_STARTTLS_AUTO=true

# For SendGrid:
# SMTP_ADDRESS=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=SG.your-sendgrid-api-key

# Storage
ACTIVE_STORAGE_SERVICE=local
