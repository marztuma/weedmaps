# Copy to .env.local and fill in. .env.local is gitignored — never commit secrets.

# ── Database ────────────────────────────────────────────────
# Pulled automatically by: npx neon env pull
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Admin ───────────────────────────────────────────────────
# Signs the admin session cookie. Set this before the admin is reachable
# from anywhere but localhost; it currently falls back to DATABASE_URL.
ADMIN_SESSION_SECRET=

# ── Email (Resend) ──────────────────────────────────────────
# Orders always appear in the admin panel. Email is layered on top and never
# blocks an order: if these are unset, the panel still records everything.
#
# RESEND_API_KEY should be created with SENDING ACCESS ONLY, not full access.
# It is never needed at build time, so keep it Sensitive in Vercel.
RESEND_API_KEY=

# The From address, on a domain verified in Resend. Resend refuses to send from
# an unverified domain, so this cannot be an arbitrary address.
MAIL_FROM="Weedmaps <orders@your-verified-domain.com>"

# Where administrative alerts go. Admin mail is only ever sent here — never to
# an address that arrived in a request.
ADMIN_EMAIL=

# Signing secret for the delivery webhook at /api/webhooks/resend. Without it
# that endpoint refuses every request, which is the correct failure: an
# unauthenticated version would let anyone suppress a customer address.
RESEND_WEBHOOK_SECRET=

# ── Cloudinary image hosting (optional) ─────────────────────
# Without these, product images serve from /public and everything works.
# With them, run `npm run images:upload` to move them to the CDN.
# Find these on your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Same value as CLOUDINARY_CLOUD_NAME. Needed in the browser, so it is public —
# that is fine, a cloud name is not a secret. The API secret must never be here.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Top-level folder for this project inside the Cloudinary account.
CLOUDINARY_FOLDER=weedmaps

# ── SEO ─────────────────────────────────────────────────────
# The public origin. Every canonical URL, sitemap entry, social-card URL and
# JSON-LD id is built from this, so it MUST be the real domain before the site
# is indexed — otherwise you publish canonicals pointing at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Delivery-service ratings in this build are demonstration figures. Structured
# data that publishes invented ratings is what search engines penalise, so
# AggregateRating is withheld unless this is explicitly "true". Turn it on only
# once the ratings come from real reviews.
SEO_PUBLISH_RATINGS=false
